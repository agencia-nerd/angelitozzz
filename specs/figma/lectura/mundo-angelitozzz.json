      "textos": [
        { "nodeId": "4017:20285", "texto": "Qué incluye tu suscripción", "estilo": "2026/Eyebrow", "color": "color/verde", "rol": "eyebrow" },
        { "nodeId": "4017:20286", "texto": "Todo lo que necesitas para nunca quedarte sin respuesta.", "estilo": "2026/H1", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "4017:20287", "texto": "Respuestas en vivo, contenido para cada etapa y una comunidad que te acompaña.", "estilo": "2026/Body L", "color": "color/verde", "rol": "subtitulo" },
        { "nodeId": "4017:20293", "texto": "Sesiones en vivo con Bárbara", "estilo": "2026/H4", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "4017:20294", "texto": "Cada semana resuelves tus dudas en vivo.", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
