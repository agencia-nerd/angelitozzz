    {
      "nombre": "promocinar-marca",
      "nodeId": "4017:20254",
      "nombreCapa": "Promocinar marca",
      "estado": "leida",
      "leidoEn": "2026-11-05",
      "tamano": { "ancho": 1920, "alto": 646 },
