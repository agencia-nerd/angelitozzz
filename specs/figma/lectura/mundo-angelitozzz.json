      "captura": "mundo-angelitozzz/hero.png",
      "textos": [
        { "nodeId": "4017:20220", "texto": "El sueño de tu bebé no para de cambiar.\nCada etapa trae nuevas preguntas. Aquí siempre hay respuestas.", "estilo": "2026/H2", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "4017:20221", "texto": "Mundo Angelitozzz es la comunidad donde resuelves tus dudas de sueño con Bárbara cada semana — para que dejes de adivinar con cada cambio.", "estilo": "2026/Body S", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "I4017:20225;3711:6162", "texto": "Quiero unirme", "estilo": "2026/Label", "color": "color/blanco", "rol": "boton" },
        { "nodeId": "4017:20226", "texto": "Desde $14/mes · Cancela cuando quieras", "estilo": "2026/Body S", "color": "color/texto", "rol": "etiqueta" },
        { "nodeId": "4017:20233", "texto": "¿Quieres regalar Mundo Angelitozzz? Escríbeme por WhatsApp.", "estilo": null, "color": null, "rol": "otro" }
