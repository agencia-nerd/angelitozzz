    {
      "nombre": "testimonios",
      "nodeId": "4017:20317",
      "nombreCapa": "Testimonios · Tarjetas",
      "estado": "leida",
      "leidoEn": "2026-11-05",
      "tamano": { "ancho": 1920, "alto": 954 },
      "referencia": "mundo-angelitozzz/testimonios.ref.txt",
      "captura": "mundo-angelitozzz/testimonios.png",
      "textos": [
        { "nodeId": "I4017:20317;3810:29", "texto": "Lo que dicen las mamás que ya son parte de Mundo Angelitozzz.", "estilo": "2026/H2", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "I4017:20317;3810:52", "texto": "“Bárbara, te quiero agradecer por tu guía durante todo este proceso. ¡Noah está durmiendo mejor que nunca y yo no lo puedo creer!”", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "I4017:20317;3810:55", "texto": "Raisa", "estilo": "2026/Label", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "I4017:20317;3810:56", "texto": "Bebé de 5 meses", "estilo": "2026/Caption", "color": "color/texto-suave", "rol": "pie" },
        { "nodeId": "I4017:20317;3810:69", "texto": "“¡Amelia es una niña feliz! Lograste lo imposible: ahora le cuento un cuento, le digo buenas noches y se duerme tranquila.”", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "I4017:20317;3810:72", "texto": "Cami", "estilo": "2026/Label", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "I4017:20317;3810:73", "texto": "Niña de 2 años", "estilo": "2026/Caption", "color": "color/texto-suave", "rol": "pie" },
        { "nodeId": "I4017:20317;3810:86", "texto": "“Balli, miles de gracias por la ayuda y la paciencia. Ni te imaginas cuán agradecida estoy: Martín ya duerme de corrido.”", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "I4017:20317;3810:89", "texto": "Bernardita y Martín", "estilo": "2026/Label", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "I4017:20317;3810:90", "texto": "Bebé de 5 meses", "estilo": "2026/Caption", "color": "color/texto-suave", "rol": "pie" },
        { "nodeId": "I4017:20317;3824:41", "texto": "“Probé de todo y nada funcionaba. Con el plan de Bárbara, en una semana mi bebé dormía en su cuna.”", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "I4017:20317;3824:48", "texto": "Carolina, mamá de Tomás", "estilo": "2026/Label", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "I4017:20317;3824:49", "texto": "Bebé de 6 meses", "estilo": "2026/Caption", "color": "color/texto-suave", "rol": "pie" },
        { "nodeId": "I4017:20317;3824:65", "texto": "“Pensé que nunca iba a volver a dormir una noche completa. Hoy dormimos todos.”", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "I4017:20317;3824:72", "texto": "Andrea, mamá de Lucas", "estilo": "2026/Label", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "I4017:20317;3824:73", "texto": "Bebé de 7 meses", "estilo": "2026/Caption", "color": "color/texto-suave", "rol": "pie" },
        { "nodeId": "I4017:20317;3810:96;3704:15612", "texto": "Ver más testimonios", "estilo": "2026/Label", "color": "color/verde", "rol": "boton" }
