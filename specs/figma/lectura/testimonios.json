      "referencia": "testimonios/seccion-testimonios.ref.txt",
      "captura": "testimonios/seccion-testimonios.png",
      "textos": [
        { "nodeId": "3749:4215", "texto": "Historias reales", "estilo": "2026/Eyebrow", "color": "color/verde-suave", "rol": "eyebrow" },
        { "nodeId": "3749:4216", "texto": "Testimonios", "estilo": "2026/H1", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "3749:4217", "texto": "Mamás que volvieron a dormir y a disfrutar su maternidad.", "estilo": "2026/Body L", "color": "color/texto", "rol": "subtitulo" },
        { "nodeId": "3749:4220", "texto": "Todos", "estilo": "2026/Label S", "color": "color/crema", "rol": "boton" },
        { "nodeId": "3749:4222", "texto": "Soluciones de Sueño", "estilo": "2026/Label S", "color": "color/verde", "rol": "boton" },
        { "nodeId": "3749:4224", "texto": "Mundo Angelitozzz", "estilo": "2026/Label S", "color": "color/verde", "rol": "boton" },
        { "nodeId": "3749:4231", "texto": "Giannina", "estilo": "2026/H4", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "I3749:4244;3719:4261", "texto": "Mundo Angelitozzz", "estilo": "2026/Label S", "color": "color/blanco", "rol": "etiqueta" },
        { "nodeId": "3749:4247", "texto": "Bebé de 2.8 años", "estilo": "2026/Label S", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "3749:4248", "texto": "Balli y la comunidad de Mundo Angelitozzz me han enseñado muchísimo! Tanto los talleres, como la interacción en el chat, son herramientas super valiosas para mí. Maternar entre varias que pasan por lo mismo no tiene precio. Empecé con mi hija mayor hace 5 años y sigo aplicando lo que aprendí con mis otros dos hijos <3.", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "3749:4253", "texto": "Andrea", "estilo": "2026/H4", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "I3749:4266;3719:4261", "texto": "Soluciones de Sueño", "estilo": "2026/Label S", "color": "color/blanco", "rol": "etiqueta" },
        { "nodeId": "3749:4269", "texto": "Bebé de 5 meses", "estilo": "2026/Label S", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "3749:4270", "texto": "Hola Balli!! Quería agradecerte por estas semanas de acompañamiento: pasamos de mini siestas de 30 min a siestas de hora y media, y de levantarme 5 veces en la noche a que duerma de corrido!! Me has dado mucha tranquilidad y por fin puedo entender a mi gordito.", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "3749:4275", "texto": "Javiera", "estilo": "2026/H4", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "I3749:4288;3719:4261", "texto": "Soluciones de Sueño", "estilo": "2026/Label S", "color": "color/blanco", "rol": "etiqueta" },
        { "nodeId": "3749:4291", "texto": "Bebé de 2 años", "estilo": "2026/Label S", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "3749:4292", "texto": "Balli, quiero darte las gracias por toda tu ayuda en el entrenamiento del sueño de mis hijos, primero con Borja y ahora con León de 6 meses. Con tu enfoque compasivo diseñaste un plan personalizado que nos ayudó a establecer rutinas adecuadas. ¡Estamos eternamente agradecidos!", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "3749:4297", "texto": "Bernardita", "estilo": "2026/H4", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "I3749:4310;3719:4261", "texto": "Mundo Angelitozzz", "estilo": "2026/Label S", "color": "color/blanco", "rol": "etiqueta" },
        { "nodeId": "3749:4313", "texto": "Bebé de 5 meses", "estilo": "2026/Label S", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "3749:4314", "texto": "Hay un antes y un después luego de tu asesoría. No fue fácil, pero la consistencia y la seguridad que nos dabas permitió que Lara, con 7 meses, aprenda a dormir sola y en su propia habitación. Gracias además al grupo que nos da orientación permanente.", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "3749:4319", "texto": "Joanna", "estilo": "2026/H4", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "I3749:4332;3719:4261", "texto": "Soluciones de Sueño", "estilo": "2026/Label S", "color": "color/blanco", "rol": "etiqueta" },
        { "nodeId": "3749:4335", "texto": "Bebé de 9 meses", "estilo": "2026/Label S", "color": "color/verde", "rol": "etiqueta" },
        { "nodeId": "3749:4336", "texto": "Sufrí una fuerte depresión postparto. Encontré un post de Bárbara con su historia y me identifiqué completamente. Comenzamos el curso: al principio fue desafiante, pero mantuvimos horarios y rutinas firmes, y TODO CAMBIÓ.", "estilo": "2026/Body", "color": "color/texto", "rol": "parrafo" },
        { "nodeId": "3749:4339", "texto": "1", "estilo": "2026/Label", "color": "color/crema", "rol": "otro" },
        { "nodeId": "3749:4341", "texto": "2", "estilo": "2026/Label", "color": "color/verde", "rol": "otro" },
        { "nodeId": "3749:4343", "texto": "3", "estilo": "2026/Label", "color": "color/verde", "rol": "otro" }
