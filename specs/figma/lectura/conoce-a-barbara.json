      "tamano": { "ancho": 1920, "alto": 863 },
      "referencia": "conoce-a-barbara/hero.ref.txt",
      "captura": "conoce-a-barbara/hero.png",
      "textos": [
        { "nodeId": "4017:21046", "texto": "Conoce a Bárbara", "estilo": "2026/Eyebrow", "color": "color/verde-suave", "rol": "eyebrow" },
        { "nodeId": "4017:21048", "texto": "Hola, soy Bárbara.", "estilo": "2026/Display", "color": "color/verde", "rol": "titulo" },
        { "nodeId": "4017:21050", "texto": "Del agotamiento al propósito — mi historia.", "estilo": "2026/Body XL", "color": "color/verde", "rol": "subtitulo" },
        { "nodeId": "4017:21053", "texto": "Hola, soy Bárbara — fundadora de Angelitozzz y mamá de dos angelitos que transformaron mi vida de la manera más intensa... y dolorosa.\nCuando nació mi hija Emma, la maternidad me golpeó con una fuerza que no esperaba. A pesar de estar informada y “lista”, terminé envuelta en noches infinitas, llanto constante, dolor físico y una angustia que no podía nombrar. Me enfrenté a una Depresión Post Parto que me hizo sentir aislada, agotada, perdida. Me sentía una extraña en mi propia historia.\nY lo más duro: sentía culpa por no estar disfrutando la experiencia que se suponía debía ser la más hermosa de mi vida.", "estilo": null, "color": "color/texto", "rol": "parrafo" }
      ],
      "sueltos": {
        "espacios": [
          { "valor": 10, "usos": 1 },
          { "valor": 56, "usos": 1 },
          { "valor": 12, "usos": 2 },
          { "valor": 80, "usos": 1 },
